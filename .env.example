# 이 파일을 복사해 .env 를 만들고 실제 키를 넣으세요.(이 파일에는 키를 적지 마세요.)

# 국토교통부 재난상황정보 (국가교통정보센터)
ITS_API_KEY=
# 기상청 API허브 기상특보
KMA_APIHUB_KEY=
# 공공데이터포털 (초단기실황·예보, 방재 AWS)
DATA_GO_KR_KEY=
# 서울 열린데이터광장 (강우량, 하수관로·하천 수위)
SEOUL_OPENDATA_KEY=
# 카카오 로컬 API (장소 검색)
KAKAO_REST_KEY=

APP_ENV=local
CORS_ORIGINS=http://localhost:5173,http://localhost:3000